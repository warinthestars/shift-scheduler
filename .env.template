# ==============================================================================
# ShiftBoard - Root Environment Configuration Template
# Copy this file to .env (or mount via .secrets/.secrets.env)
# ==============================================================================

# Project & Environment
PROJECT_NAME=shiftboard
ENVIRONMENT=development
LOG_LEVEL=info

# Domain & Reverse Proxy
APP_DOMAIN=shiftboard.local
PORT_FRONTEND=80
PORT_BACKEND=8000

# PostgreSQL Database Configuration
POSTGRES_DB=shiftboard
POSTGRES_USER=shiftboard_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_PORT=6379

# Cloudflare Tunnel Configuration
# If using a named tunnel with token:
CLOUDFLARE_TUNNEL_TOKEN=
# If using a credentials file:
CLOUDFLARE_TUNNEL_ID=
