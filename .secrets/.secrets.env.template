# ==============================================================================
# ShiftBoard - Docker Secrets Configuration Template
# Save as: .secrets/.secrets.env (IGNORED BY GIT)
# ==============================================================================

# Super Admin Password
SUPER_ADMIN_PASSWORD=SuperSecretDemo123!

# JWT Secret
JWT_SECRET_KEY=shiftboard_local_jwt_secret_key_please_change_in_production_32chars

# Database
POSTGRES_DB=shiftboard
POSTGRES_USER=shiftboard_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# Redis
REDIS_PASSWORD=replace_with_secure_redis_password

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflared_tunnel_token

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=shiftboard-media

# Firebase Authentication
# true  = demo mode: shows the mocked "Sign in with Google (Demo)" button, no real Firebase
# false = real Firebase: users sign in with Google and are auto-provisioned as workers
USE_MOCK_FIREBASE=false

# Firebase web config (the firebaseConfig snippet from the Firebase Console) lives in its
# own file because it is JavaScript, not KEY=VALUE, and would break docker compose here:
#   copy  .secrets/firebase-web-config.js.template  ->  .secrets/firebase-web-config.js
#   then paste the snippet from Firebase Console > Project settings > Your apps > SDK setup.
# Path as seen inside the backend container (.secrets is mounted at /app/secrets):
FIREBASE_WEB_CONFIG_PATH=/app/secrets/firebase-web-config.js

# Self-service sign-up. true = public "Create account" button (new users become Workers).
# false = only users an admin created (or already linked) can sign in.
ALLOW_SELF_REGISTRATION=true

# Sign-in buttons are discovered automatically from the providers enabled in
# Firebase Console > Authentication > Sign-in method (refreshed every 5 minutes).
# Optional override - leave blank to auto-discover. Comma-separated, any of:
#   password, google.com, microsoft.com, apple.com, github.com, facebook.com, twitter.com, yahoo.com
FIREBASE_AUTH_PROVIDERS=

# ------------------------------------------------------------------------------
# Notifications (Phase 28)
# ------------------------------------------------------------------------------
# Public address of the site; used for links inside emails and texts.
APP_BASE_URL=https://dev-scheduler.jaccollective.com

# Background worker (reminders, late alerts, digests, sending). Leave true.
NOTIFICATIONS_WORKER_ENABLED=true
# Hour (in each user's own timezone) the daily "new shifts" digest goes out.
NOTIFICATIONS_DIGEST_HOUR=9

# Email: console = only printed in the backend log (safe default)
#        smtp    = any SMTP server (Gmail/Workspace app password, Mailgun, SES, ...)
#        resend  = Resend.com API
EMAIL_PROVIDER=console
EMAIL_FROM=ShiftBoard <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
RESEND_API_KEY=

# Text messages: off | console | twilio  (only urgent messages are ever texted)
SMS_PROVIDER=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
