# ==============================================================================
# ShiftBoard - Backend Environment Configuration Template
# Copy this file to backend/.env
# ==============================================================================

# Application Environment
ENV=development
DEBUG=True
PORT=8000

# Super Admin Seeding Credentials
SUPER_ADMIN_USERNAME=demo_admin@shiftboard.com
SUPER_ADMIN_PASSWORD=SuperSecretDemo123!

# Authentication & JWT Configuration
JWT_SECRET_KEY=shiftboard_local_jwt_secret_key_please_change_in_production_32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Mock Mode (Set to true to use mocked token verification for local dev/sharing)
USE_MOCK_FIREBASE=true

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1:5173

# PostgreSQL Connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://shiftboard_user:replace_with_secure_postgres_password@database:5432/shiftboard
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Task Queue
REDIS_URL=redis://:replace_with_secure_redis_password@redis:6379/0

# Firebase Admin SDK (Authentication & JWT Validation)
# Can specify path to service account JSON or inline values
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase_service_account.json
FIREBASE_PROJECT_ID=shiftboard-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@shiftboard-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 Storage (S3-Compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=shiftboard-media
R2_S3_ENDPOINT_URL=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL_PREFIX=https://cdn.yourdomain.com

# Geofence Validation Defaults
DEFAULT_GEOFENCE_RADIUS_METERS=100
