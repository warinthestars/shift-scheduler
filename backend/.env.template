# ==============================================================================
# ShiftUp - backend settings for running the API OUTSIDE Docker (local uvicorn)
#
# With Docker you don't need this file: docker compose gives the backend .env,
# .secrets/stack.env and .secrets/integrations.env (their templates document every setting).
#
# Local run, from the backend/ folder:
#   cp .env.template .env           (backend/.env is ignored by git)
#   set -a; . ./.env; set +a         (bash / zsh: load it into the environment)
#   uvicorn src.main:app --reload --port 8000
# Load it into the environment as shown: some settings are read straight from the
# environment when the app starts, so the file alone isn't enough.
#
# Don't keep a backend/.env while you run with Docker: the backend folder is mounted
# into the container, and any setting missing from the root .env would be picked up here.
# ==============================================================================

# Database: a PostgreSQL you can reach from this computer (e.g. the Docker one on localhost)
POSTGRES_USER=shiftboard_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shiftboard

# Redis
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0

# Sign-in
ENV=development
DEBUG=true
SECRET_KEY=your_long_random_secret_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
SUPER_ADMIN_USERNAME=demo_admin@shiftboard.com
SUPER_ADMIN_PASSWORD=your_admin_password_here
ALWAYS_ADMIN_EMAILS=
ALLOW_SELF_REGISTRATION=true
SHOW_DEMO_LOGINS=false
PUBLIC_EVENT_BOARD=false
CALENDAR_SYNC=true

# Firebase: paths relative to backend/ when running locally
USE_MOCK_FIREBASE=false
FIREBASE_AUTH_PROVIDERS=
FIREBASE_WEB_CONFIG_PATH=../.secrets/firebase-web-config.js
FIREBASE_CREDENTIALS_PATH=../.secrets/firebase_service_account.json
FIREBASE_VAPID_KEY=

# Notifications: console / off keep everything local
APP_BASE_URL=http://localhost:5173
NOTIFICATIONS_WORKER_ENABLED=true
EMAIL_PROVIDER=console
SMS_PROVIDER=off

# Cloudflare R2 (reserved: not used by the app yet)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shiftboard-media
R2_S3_ENDPOINT_URL=
R2_PUBLIC_URL_PREFIX=

# Everything else (SMTP, Twilio, push keys, ...) is optional: copy it from /.env.template if you need it.
